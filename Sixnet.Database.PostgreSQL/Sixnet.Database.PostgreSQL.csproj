<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>sixnet.snk</AssemblyOriginatorKeyFile>
		<Authors>DingBin.Li</Authors>
		<Copyright>Copyright © DingBin.Li</Copyright>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
		<PackageReference Include="Npgsql" Version="6.0.13" />
		<PackageReference Include="Sixnet" Version="2.1.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Npgsql" Version="8.0.9" />
		<PackageReference Include="Sixnet" Version="2.1.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="Sixnet" Version="2.1.1" />
	</ItemGroup>

</Project>
